
{
  "metadata": [
    {
      "src": [
        {
          "files": [
            "AsmLocator.dll"
          ],
          "src": "../src/AsmLocator/bin/Release/net10.0"
        }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [
      {
        "files": [
          "api/**/*.yml"
        ]
      },
      {
        "files": [
          "*.md",
          "toc.yml",
          "articles/**/*.md",
          "articles/toc.yml"
        ]
      }
    ],
    "resource": [
      {
        "files": [
          "images/**"
        ]
      }
    ],
    "dest": "_site",
    "template": [
      "default",
      "modern"
    ],
    "globalMetadata": {
      "_appTitle": "AsmLocator Documentation",
      "_appName": "AsmLocator",
      "_enableSearch": true,
      "_disableContribution": false
    }
  }
}
